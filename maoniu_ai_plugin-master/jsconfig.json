{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ],
            "service/*": [
                "src/js/service/*"
            ],
            "aliService/*": [
                "src/js/ali_service/*"
            ]
        }
    },
    "vueCompilerOptions": {
        // "target": 2.7,
        // "target": 2, // For Vue version <= 2.6.14
    },
    "exclude": [
        "node_modules",
        "build"
    ],
}