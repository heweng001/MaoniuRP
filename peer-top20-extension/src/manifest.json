{
  "manifest_version": 3,
  "name": "AI操盘手-重制版",
  "version": "1.3.19",
  "description": "为 AI操盘手-重制版 采集阿里巴巴同行数据",  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "*://*.alibaba.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AI操盘手-重制版",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "http://*/*",
      "https://*/*",
      "*://*.maoniux.com/*",
      "*://*.maoniunet.com/*"
    ]
  }
}
